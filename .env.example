# 複製成 .env 後填入你自己的設定（copy .env.example .env）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密碼
DB_NAME=maple_orders

# n8n webhook（測試用 /webhook-test/，上線改 /webhook/）
N8N_WEBHOOK_URL=https://app-n8n-cloud86lin.app.n8n.cloud/webhook-test/9acb694b-c852-4551-a901-ef9db5318a8e

# 店家後台 /admin 的密碼（帳號固定為 admin）
ADMIN_PASSWORD=請改成你自己的密碼
